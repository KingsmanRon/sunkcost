{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/KingsmanRon/sunkcost/main/packages/spec/schemas/ingest-batch.v1.json",
  "title": "Ingest batch v1",
  "description": "Body of POST /v1/ingest: up to 1,000 run_start, step, run_end and outcome events, at most 1 MB. Every event field is required; optional values are sent as null.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sent_at", "sdk", "dropped_events", "events"],
  "properties": {
    "schema_version": { "const": "1" },
    "sent_at": { "$ref": "common.v1.json#/$defs/timestamp" },
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "version": { "type": "string", "pattern": "^[0-9A-Za-z.+-]{1,64}$" }
      }
    },
    "dropped_events": {
      "description": "Events this SDK instance dropped from its buffer (overflow) since the previous accepted batch.",
      "$ref": "common.v1.json#/$defs/safe_uint"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["run_start", "step", "run_end", "outcome"] }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "run_start" } } },
          "then": { "$ref": "#/$defs/run_start" }
        },
        {
          "if": { "properties": { "type": { "const": "step" } } },
          "then": { "$ref": "#/$defs/step" }
        },
        {
          "if": { "properties": { "type": { "const": "run_end" } } },
          "then": { "$ref": "#/$defs/run_end" }
        },
        {
          "if": { "properties": { "type": { "const": "outcome" } } },
          "then": { "$ref": "#/$defs/outcome" }
        }
      ]
    },
    "run_start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "run_id",
        "workload",
        "external_ref",
        "started_at",
        "bundle_id",
        "bundle_version",
        "mode",
        "holdout"
      ],
      "properties": {
        "type": { "const": "run_start" },
        "run_id": { "$ref": "common.v1.json#/$defs/uuid_v7" },
        "workload": { "$ref": "common.v1.json#/$defs/workload_name" },
        "external_ref": {
          "anyOf": [{ "type": "null" }, { "$ref": "common.v1.json#/$defs/external_ref" }]
        },
        "started_at": { "$ref": "common.v1.json#/$defs/timestamp" },
        "bundle_id": {
          "description": "The bundle this run is evaluated against for its whole duration; null when there was none.",
          "anyOf": [{ "type": "null" }, { "$ref": "common.v1.json#/$defs/uuid" }]
        },
        "bundle_version": {
          "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": 1, "maximum": 2147483647 }]
        },
        "mode": {
          "description": "Effective mode at run start: shadow when there is no usable bundle or an override is set.",
          "$ref": "common.v1.json#/$defs/mode"
        },
        "holdout": { "type": "boolean" }
      },
      "if": { "properties": { "bundle_id": { "type": "null" } } },
      "then": { "properties": { "bundle_version": { "type": "null" } } },
      "else": { "properties": { "bundle_version": { "type": "integer" } } }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "run_id",
        "seq",
        "ts",
        "kind",
        "model",
        "tool_name",
        "args_hash",
        "input_tokens",
        "output_tokens",
        "cost_usd",
        "error",
        "latency_ms",
        "decision"
      ],
      "properties": {
        "type": { "const": "step" },
        "run_id": { "$ref": "common.v1.json#/$defs/uuid_v7" },
        "seq": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "ts": {
          "description": "When the step completed (record_step time), on the same client clock as run_start.started_at.",
          "$ref": "common.v1.json#/$defs/timestamp"
        },
        "kind": { "type": "string", "enum": ["model", "tool"] },
        "model": { "anyOf": [{ "type": "null" }, { "$ref": "common.v1.json#/$defs/text" }] },
        "tool_name": { "anyOf": [{ "type": "null" }, { "$ref": "common.v1.json#/$defs/text" }] },
        "args_hash": {
          "description": "hmac-sha256:<hex> of the canonical tool arguments, keyed with a salt that never leaves the customer.",
          "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$" }]
        },
        "input_tokens": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "output_tokens": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "cost_usd": {
          "description": "null when the cost is unknown (no cost_usd given and the model is not in prices.v1). Unknown costs count as 0.",
          "anyOf": [{ "type": "null" }, { "$ref": "common.v1.json#/$defs/money" }]
        },
        "error": { "type": "boolean" },
        "latency_ms": {
          "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": 0, "maximum": 86400000 }]
        },
        "decision": {
          "description": "The check() decision made on the prefix of steps 1..seq-1; null if check() was not called before this step.",
          "anyOf": [{ "type": "null" }, { "$ref": "decision.v1.json#/$defs/step_decision" }]
        }
      }
    },
    "run_end": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "run_id",
        "ended_at",
        "status",
        "total_cost_usd",
        "steps",
        "would_abort_step",
        "cost_through_would_abort_usd",
        "aborted_step"
      ],
      "properties": {
        "type": { "const": "run_end" },
        "run_id": { "$ref": "common.v1.json#/$defs/uuid_v7" },
        "ended_at": { "$ref": "common.v1.json#/$defs/timestamp" },
        "status": { "type": "string", "enum": ["completed", "aborted", "errored"] },
        "total_cost_usd": { "$ref": "common.v1.json#/$defs/money" },
        "steps": { "$ref": "common.v1.json#/$defs/count" },
        "would_abort_step": {
          "description": "Prefix length k of the first check() with would_abort = true, or null. Saving = total cost - cost through step k.",
          "anyOf": [{ "type": "null" }, { "$ref": "common.v1.json#/$defs/count" }]
        },
        "cost_through_would_abort_usd": {
          "description": "Cost of steps 1..would_abort_step; null exactly when would_abort_step is null.",
          "anyOf": [{ "type": "null" }, { "$ref": "common.v1.json#/$defs/money" }]
        },
        "aborted_step": {
          "description": "Prefix length k of the first check() that returned ABORT, or null.",
          "anyOf": [{ "type": "null" }, { "$ref": "common.v1.json#/$defs/count" }]
        }
      },
      "if": { "properties": { "would_abort_step": { "type": "null" } } },
      "then": {
        "properties": {
          "cost_through_would_abort_usd": { "type": "null" },
          "aborted_step": { "type": "null" }
        }
      },
      "else": { "properties": { "cost_through_would_abort_usd": { "type": "string" } } }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "run_id", "outcome", "source", "reported_at"],
      "properties": {
        "type": { "const": "outcome" },
        "run_id": { "$ref": "common.v1.json#/$defs/uuid_v7" },
        "outcome": { "$ref": "common.v1.json#/$defs/outcome" },
        "source": { "$ref": "common.v1.json#/$defs/outcome_source" },
        "reported_at": { "$ref": "common.v1.json#/$defs/timestamp" }
      }
    }
  }
}
