{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/KingsmanRon/sunkcost/main/packages/spec/schemas/prices.v1.json",
  "title": "Price table v1",
  "description": "Effective-dated USD list prices per 1M tokens, each from an official provider pricing page. Used only when record_step() is called without cost_usd. Lookup rules are in packages/spec/README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "currency", "unit", "models"],
  "properties": {
    "schema_version": { "const": "1" },
    "currency": { "const": "USD" },
    "unit": { "const": "per_1m_tokens" },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "aliases", "prices"],
      "properties": {
        "provider": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
        "model": { "$ref": "#/$defs/model_id" },
        "aliases": {
          "description": "Other exact model strings (dated snapshots, provider-prefixed forms) that bill identically.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/model_id" }
        },
        "prices": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/price" }
        }
      }
    },
    "model_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127}$" },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effective_from", "input", "output", "tiers", "source_url", "retrieved_at"],
      "properties": {
        "effective_from": { "$ref": "common.v1.json#/$defs/date" },
        "input": { "$ref": "common.v1.json#/$defs/money" },
        "output": { "$ref": "common.v1.json#/$defs/money" },
        "tiers": {
          "description": "Per-request long-context prices. The tier with the largest above_input_tokens that is < the step's input_tokens replaces input and output for that step.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["above_input_tokens", "input", "output"],
            "properties": {
              "above_input_tokens": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
              "input": { "$ref": "common.v1.json#/$defs/money" },
              "output": { "$ref": "common.v1.json#/$defs/money" }
            }
          }
        },
        "source_url": { "type": "string", "pattern": "^https://[^\\s]{1,500}$" },
        "retrieved_at": { "$ref": "common.v1.json#/$defs/date" },
        "notes": { "type": "string", "maxLength": 500 }
      }
    }
  }
}
