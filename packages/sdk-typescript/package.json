{
  "name": "sunkcost",
  "version": "0.1.0",
  "private": true,
  "description": "Sunkcost TypeScript SDK: stop agent runs that are going to fail.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "bench": "tsc -p tsconfig.build.json && node bench/check.mjs",
    "test:failure": "tsc -p tsconfig.build.json && vitest run --config vitest.failure.config.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@noble/ed25519": "3.2.0"
  }
}
